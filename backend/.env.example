# ==============================================================================
# Poietik Academy - Backend Environment Configuration (.env)
# ==============================================================================

# Django Secret Key (required in production; generate with python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-production-secret-key-change-me

# Debug Mode: set to False in production
DEBUG=False

# Allowed Hosts: comma-separated hostnames (onrender.com is automatically included)
ALLOWED_HOSTS=poietik-academy-api.onrender.com,localhost,127.0.0.1

# Neon PostgreSQL Database Connection String
# Example: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Frontend URL(s) - used for CORS and CSRF trusted origins
# Can be a single URL or comma-separated list of URLs
FRONTEND_URL=https://poietik-academy.vercel.app

# Optional extra CORS and CSRF origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://poietik-academy.vercel.app
CSRF_TRUSTED_ORIGINS=https://poietik-academy.vercel.app

# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_test_f0a8b2ee5dc0776e8629b4bb5a81b5cab6173ca5
PAYSTACK_PUBLIC_KEY=pk_test_f6de2516f0f131877c2e4f6e4c0fce3f9d85d5ff

# Post-payment redirect URL (points to Vercel success page)
PAYSTACK_CALLBACK_URL=https://poietik-academy.vercel.app/enrollment/success

# Initial Superuser Credentials (used by python manage.py setup_initial_data)
ADMIN_USERNAME=saint-poietik
ADMIN_PASSWORD=poietikacademyi$thebestinwEb£duc8tion
ADMIN_EMAIL=ignituspoietik@gmail.com

