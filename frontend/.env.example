# ==============================================================================
# Poietik Academy - Frontend Environment Configuration (.env)
# ==============================================================================

# Backend API Base URL (Render backend URL with /api suffix, without trailing slash)
# In production on Vercel, set this in Vercel Project Settings -> Environment Variables.
# Local development default: /api (proxied via Vite to http://127.0.0.1:8000)
VITE_API_BASE_URL=https://poietik-academy-api.onrender.com/api
